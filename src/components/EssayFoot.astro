---
import type { Piece } from '~/lib/content';
import { formatIssueLabel } from '~/lib/content';
import type { Lang } from '~/i18n/dictionary';

export interface Props {
  lang: Lang;
  piece: Piece;
}
const { lang, piece } = Astro.props;

const issueLabel = formatIssueLabel(piece.data.issue, lang);
const pageLabel = lang === 'pt' ? 'página xiv, recto' : 'page xiv, recto';
const sigLabel = lang === 'pt' ? 'caderno b · 14 de iv' : 'gathering b · 14 of iv';
---
<div class="folio">
  <span>{issueLabel}</span>
  <span class="roman">{pageLabel}</span>
  <span>{sigLabel}</span>
</div>
<div class="article-foot">
  <div class="endmark"></div>
  <div class="author-card">
    <div class="name">{piece.data.author}</div>
    {piece.data.authorBio && <div class="bio" set:html={piece.data.authorBio} />}
  </div>
</div>
