---
import { type Lang, t } from '~/i18n/dictionary';
export interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<article class="article-body">
  <p class="first" set:html={t(lang, 'art-first')} />

  <p>
    <Fragment set:html={t(lang, 'art-p1')} /><sup class="fn" tabindex="0" role="button" aria-label="footnote 1">1<span class="fn-pop" set:html={t(lang, 'fn-1')} /></sup>
  </p>

  <p set:html={t(lang, 'art-p2')} />

  <h2 class="section">
    <span class="num">i</span><span set:html={t(lang, 'art-h-1')} />
  </h2>

  <p set:html={t(lang, 'art-p3')} />

  <p>
    <Fragment set:html={t(lang, 'art-p4')} /><sup class="fn" tabindex="0" role="button" aria-label="footnote 2">2<span class="fn-pop" set:html={t(lang, 'fn-2')} /></sup>
  </p>

  <div class="figure">
    <div class="frame"></div>
    <div class="cap">
      <span class="num">fig. 1</span>
      <span set:html={t(lang, 'fig-1')} />
    </div>
  </div>

  <p set:html={t(lang, 'art-p5')} />

  <p class="pull" set:html={t(lang, 'art-pull')} />

  <h2 class="section">
    <span class="num">ii</span><span set:html={t(lang, 'art-h-2')} />
  </h2>

  <p set:html={t(lang, 'art-p6')} />
  <p set:html={t(lang, 'art-p7')} />

  <p>
    <Fragment set:html={t(lang, 'art-p8')} /><sup class="fn" tabindex="0" role="button" aria-label="footnote 3">3<span class="fn-pop" set:html={t(lang, 'fn-3')} /></sup>
  </p>

  <h2 class="section">
    <span class="num">iii</span><span set:html={t(lang, 'art-h-3')} />
  </h2>

  <p set:html={t(lang, 'art-p9')} />
  <p set:html={t(lang, 'art-p10')} />
  <p set:html={t(lang, 'art-p11')} />
</article>
