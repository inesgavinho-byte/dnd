---
import { type Lang, t } from '~/i18n/dictionary';
import { getCurrentIssue } from '~/lib/content';

export interface Props { lang: Lang; }
const { lang } = Astro.props;

const issue = await getCurrentIssue();
---
<section class="agenda">
  <div class="agenda-head reveal">
    <div class="l" set:html={t(lang, 'agenda-l')} />
    <div></div>
    <div class="r" set:html={t(lang, 'agenda-r')} />
  </div>
  <div class="agenda-grid reveal">
    {issue.data.agenda.map((item) => (
      <div class="agenda-item">
        <div class="when" set:html={item.when[lang]} />
        <div class="where" set:html={item.where[lang]} />
        <div class="what" set:html={item.what[lang]} />
      </div>
    ))}
  </div>
</section>
