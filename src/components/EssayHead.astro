---
import { type Lang, t, pathFor } from '~/i18n/dictionary';
export interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<section class="article-head">
  <div class="article-crumbs">
    <a class="crumb" href={pathFor(lang, '/')} set:html={t(lang, 'crumb-iss')} />
    <span class="sep">/</span>
    <span class="sec" set:html={t(lang, 'sec-essay')} />
    <span class="sep">/</span>
    <span set:html={t(lang, 'crumb-no')} />
  </div>
  <h1 class="atitle" set:html={t(lang, 'art-title')} />
  <p class="adeck" set:html={t(lang, 'art-deck')} />
  <div class="ameta">
    <div class="cell">
      <span set:html={t(lang, 'meta-by')} />
      <span class="v">Mariana Cabral</span>
    </div>
    <div class="cell">
      <span set:html={t(lang, 'meta-pub')} />
      <span class="v">12.03.2026</span>
    </div>
    <div class="cell">
      <span set:html={t(lang, 'meta-len')} />
      <span class="v">2,420 {lang === 'pt' ? 'palavras' : 'words'}</span>
    </div>
    <div class="cell">
      <span set:html={t(lang, 'meta-read')} />
      <span class="v">14 {lang === 'pt' ? 'minutos' : 'minutes'}</span>
    </div>
  </div>
</section>
