---
import { type Lang, t, pathFor } from '~/i18n/dictionary';
import { getCurrentIssue, getPiecesForIssue, sectionLabelKey } from '~/lib/content';

export interface Props { lang: Lang; }
const { lang } = Astro.props;

const issue = await getCurrentIssue();
const pieces = await getPiecesForIssue(issue.data.number, lang);
---
<section class="contents">
  <div class="contents-head reveal">
    <div class="l" set:html={t(lang, 'contents-l')} />
    <div class="c" set:html={issue.data.contentsBlurb[lang]} />
    <div class="r">{issue.data.contentsRange}</div>
  </div>

  <div class="contents-grid">
    {pieces.map((p) => {
      const num = String(p.data.pieceNumber ?? 0).padStart(2, '0');
      const href = p.data.hasBody ? pathFor(lang, `/essay/${p.data.pieceSlug}`) : null;
      const inner = (
        <>
          <div class="num">{num}</div>
          <div class="body">
            <div class="sec" set:html={t(lang, sectionLabelKey(p.data.section))} />
            <div class="ttl" set:html={p.data.title} />
            <div class="auth">{p.data.author}</div>
          </div>
          <div class="pp">{p.data.lengthWords ? `${p.data.lengthWords.toLocaleString(lang === 'pt' ? 'pt-PT' : 'en-GB')} w` : ''}</div>
        </>
      );
      return href
        ? <a class="toc reveal" href={href}>{inner}</a>
        : <div class="toc reveal">{inner}</div>;
    })}
  </div>

  <div class="fob reveal">
    {issue.data.frontOfBook.map((col) => (
      <div class="col">
        <div class="lab" set:html={col.label[lang]} />
        <h4 set:html={col.title[lang]} />
        <p set:html={col.body[lang]} />
        <div class="by" set:html={col.by[lang]} />
      </div>
    ))}
  </div>
</section>
